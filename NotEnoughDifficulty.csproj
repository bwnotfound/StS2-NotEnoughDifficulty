<Project Sdk="Godot.NET.Sdk/4.5.1">

  <!--
    StS2-NotEnoughDifficulty → 当前 beta (sts2 v0.111.0 / BaseLib 3.4.5) 移植构建工程

    与原仓库 csproj 的差异（共 9 项，均为"构建配置"，业务代码 0 行改动）：
      1. Godot.NET.Sdk 4.5.2 → 4.5.1        (对齐游戏实际引擎：MegaCrit Godot 4.5.1 分支)
      2. Alchyr.Sts2.BaseLib(3.3.0) → 本地 _refs\baselib\BaseLib.dll (本机为 3.4.5)
      3. 移除 Krafs.Publicizer 2.3.0          (原 csproj 中其 ItemGroup 即为 Condition="False"，未启用)
      4. 移除 Alchyr.Sts2.ModAnalyzers        (仅提供本地化 key 校验告警，对构建非必需；且 nuget 不可达)
      5. sts2 / 0Harmony HintPath → 指向 _refs\game\  (自包含，不依赖游戏安装路径)
      6. 不再依赖 Sts2PathDiscovery.props      (注册表/Steam 探测在沙箱内不可用)
      7. CustomModsPath → 本机实际安装目标      (原值为作者个人中文目录名)
      8. 不需要 GodotPath / GodotPublish        (.pck 由 _tools\MakePck 程序化生成，不用 Godot 导出)
      9. 移除 ModUploader 自动拷贝目标          (其依赖的 ..\ModUploader-win-x64 不存在)

    本地引用与离线包源见 ..\_refs\ ，nuget.config 已把源限定为该本地 feed。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NotEnoughDifficulty</AssemblyName>
    <RootNamespace>NotEnoughDifficulty</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <NoWarn>$(NoWarn);MSB3270;CS8632</NoWarn>
  </PropertyGroup>

  <!-- 移植目标：本机游戏 mods 目录（官方本地模组目录，删除即净）
       注意：写入游戏目录在工作区沙箱外，需显式 InstallToGameMods=true 才会拷贝；
       默认只暂存到工作区 .\dist\，便于在无权限情形下也能完成构建验证。 -->
  <PropertyGroup>
    <Sts2ModsDir>D:\Steam\steamapps\common\Slay the Spire 2\mods</Sts2ModsDir>
    <CustomModsPath>$(Sts2ModsDir)\NotEnoughDifficulty</CustomModsPath>
    <InstallToGameMods Condition="'$(InstallToGameMods)' == ''">false</InstallToGameMods>
    <DistDir>$(MSBuildProjectDirectory)\dist</DistDir>
  </PropertyGroup>

  <!-- 源码：仅 NotEnoughDifficultyCode\**，与原工程一致 -->
  <ItemGroup>
    <Compile Include="NotEnoughDifficultyCode\**\*.cs" />
  </ItemGroup>

  <!-- 游戏与 BaseLib 程序集：全部来自工作区内 _refs，不触碰游戏目录 -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>..\_refs\game\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>..\_refs\baselib\BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\_refs\game\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 资源/文档（与原工程一致；Godot 的 .import 类资源不参与编译） -->
  <ItemGroup>
    <Compile Remove="NotEnoughDifficulty\**" />
    <EmbeddedResource Remove="NotEnoughDifficulty\**" />
    <None Include="NotEnoughDifficulty.json" />
    <None Include="project.godot" />
    <None Include="NotEnoughDifficulty\**" />
    <Content Include="README.md" />
    <Content Include="docs\README.en.md" />
    <Content Include="docs\README.workshop.md" />
    <Content Include="LICENSE" />
  </ItemGroup>

  <!-- 构建后：先暂存到工作区 dist\（始终执行）；仅当 InstallToGameMods=true 时才拷进游戏 mods\ -->
  <Target Name="StageToDist" AfterTargets="Build">
    <MakeDir Directories="$(DistDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\NotEnoughDifficulty.json" DestinationFolder="$(DistDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DistDir)" ContinueOnError="WarnAndContinue" />
    <Message Text="[移植构建] 暂存 → $(DistDir)" Importance="high" />
  </Target>

  <Target Name="InstallToModsFolder" AfterTargets="StageToDist" Condition="'$(InstallToGameMods)' == 'true'">
    <MakeDir Directories="$(CustomModsPath)" />
    <Copy SourceFiles="$(DistDir)\$(TargetFileName)" DestinationFolder="$(CustomModsPath)" />
    <Copy SourceFiles="$(DistDir)\NotEnoughDifficulty.json" DestinationFolder="$(CustomModsPath)" />
    <Copy SourceFiles="$(DistDir)\$(TargetName).pdb" DestinationFolder="$(CustomModsPath)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(DistDir)\NotEnoughDifficulty.pck" DestinationFolder="$(CustomModsPath)" ContinueOnError="WarnAndContinue" />
    <Message Text="[移植构建] 已安装 → $(CustomModsPath)" Importance="high" />
  </Target>

</Project>
