<?xml version="1.0" encoding="utf-8"?>
<!--
  离线构建：源只指向工作区内 _refs\nuget-feed（含 4 个 Godot 4.5.1 包的 nupkg）。
  clear 掉 nuget.org —— 本机沙箱对外网 HTTPS 不可用（schannel SEC_E_NO_CREDENTIALS），
  且移植目标就是"自包含、零网络依赖"。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-refs" value="..\_refs\nuget-feed" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="..\_refs\nuget-cache" />
  </config>
</configuration>
